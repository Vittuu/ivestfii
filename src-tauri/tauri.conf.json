{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IvestFII",
  "version": "0.1.13",
  "identifier": "com.ivestfii.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IvestFII",
        "width": 1380,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 680,
        "visible": false,
        "backgroundColor": "#161514"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Gestão local de carteira de FIIs",
    "category": "Finance",
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma",
        "languages": [
          "PortugueseBR"
        ]
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    }
  },
  "mainBinaryName": "IvestFII",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Vittuu/ivestfii/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1OUI3MTM2RjFDRTNDOEYKUldTUFBNN3hObkdiVmNiWW9QWlpQTE0vcmtlMFZxSHJIYXJjWkZpZWdvZzFIUW5qNDhML2w0NXoK"
    }
  }
}
